<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-perigon</ToolCommandName>
    <PackageId>Perigon.PostgreSQL.Tools</PackageId>
    <Title>Perigon.PostgreSQL.Tools</Title>
    <Version>0.1.5</Version>
    <Description>Command line tools for Perigon.PostgreSQL reverse engineering and scaffolding.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReleaseNotes>0.1.5 updates the reverse-engineering and scaffolding
      command surface, aligns the CLI package with the core library release, and
      keeps the dotnet-perigon tool packaging metadata current. See
      RELEASE_NOTES.md for details.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\RELEASE_NOTES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
