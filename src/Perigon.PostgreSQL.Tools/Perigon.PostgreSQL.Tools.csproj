<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-perigon</ToolCommandName>
    <PackageId>Perigon.PostgreSQL.Tools</PackageId>
    <Title>Perigon.PostgreSQL.Tools</Title>
    <Version>0.1.7</Version>
    <Description>Command line tools for Perigon.PostgreSQL migrations, reverse engineering, and scaffolding.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReleaseNotes>0.1.7 aligns with the core package fix for clean-build
      NuGet packing. Includes migration generation, listing, SQL scripts, database
      updates, and baseline commands alongside reverse engineering and scaffolding.
      See RELEASE_NOTES.md for details.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <ProjectReference Include="..\Perigon.PostgreSQL\Perigon.PostgreSQL.csproj" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\RELEASE_NOTES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
